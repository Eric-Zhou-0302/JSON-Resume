---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Hero from "../../components/Hero.astro";
import Features from "../../components/Features.astro";
import Workflow from "../../components/Workflow.astro";
import Showcase from "../../components/Showcase.astro";
import Locales from "../../components/Locales.astro";
import Footer from "../../components/Footer.astro";
import { getContent } from "../../i18n";

const content = getContent("en");
---

<Base
  title={content.siteTitle}
  description={content.siteDescription}
  htmlLang={content.htmlLang}
>
  <Nav nav={content.nav} locale={content.code} />
  <main>
    <Hero hero={content.hero} />
    <Features features={content.features} locale={content.code} />
    <Workflow workflow={content.workflow} />
    <Showcase showcase={content.showcase} />
    <Locales locales={content.locales} />
  </main>
  <Footer footer={content.footer} />
</Base>