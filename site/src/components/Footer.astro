---
import GithubMark from "./GithubMark.astro";
import type { FooterCopy } from "../i18n/types";

interface Props {
  footer: FooterCopy;
}

const { footer } = Astro.props;
const repoHref = "https://github.com/Eric-Zhou-0302/JSON-Resume";
const skillHref =
  "https://github.com/Eric-Zhou-0302/JSON-Resume/blob/main/SKILL.md";
---

<footer class="border-t border-rule">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div
      class="grid grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-12"
    >
      <div class="lg:col-span-7">
        <h2
          class="font-display text-[clamp(1.6rem,2.8vw,2.1rem)] font-semibold tracking-tight text-ink"
        >
          {footer.heading}
        </h2>
        <p class="mt-3 max-w-[52ch] text-[15px] leading-[1.6] text-ink-muted">
          {footer.body}
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a
            href={repoHref}
            target="_blank"
            rel="noopener"
            class="jr-magnetic inline-flex items-center gap-2 rounded-[var(--radius-control)] px-4 py-2.5 text-[14px] font-medium"
            style="background-color: var(--color-accent); color: var(--color-accent-ink);"
          >
            <GithubMark class="h-4 w-4" />
            {footer.ctaPrimary}
          </a>
          <a
            href={skillHref}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-[var(--radius-control)] border border-rule-strong px-4 py-2.5 text-[14px] font-medium text-ink hover:bg-surface"
          >
            {footer.ctaSecondary}
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <dl class="grid grid-cols-2 gap-x-6 gap-y-5 font-mono-tight text-[12.5px]">
          <div>
            <dt class="text-ink-faint">{footer.meta.license}</dt>
            <dd class="mt-1 text-ink">{footer.meta.licenseValue}</dd>
          </div>
          <div>
            <dt class="text-ink-faint">{footer.meta.runtime}</dt>
            <dd class="mt-1 text-ink">{footer.meta.runtimeValue}</dd>
          </div>
          <div>
            <dt class="text-ink-faint">{footer.meta.locales}</dt>
            <dd class="mt-1 text-ink">{footer.meta.localesValue}</dd>
          </div>
          <div>
            <dt class="text-ink-faint">{footer.meta.output}</dt>
            <dd class="mt-1 text-ink">{footer.meta.outputValue}</dd>
          </div>
        </dl>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col-reverse items-start justify-between gap-3 border-t border-rule pt-6 sm:flex-row sm:items-center"
    >
      <p class="font-mono-tight text-[11.5px] text-ink-faint">
        {footer.copyright}
      </p>
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-1.5 text-[12.5px] text-ink-muted">
        <li>
          <a class="hover:text-ink" href="#features">{footer.navLinks.features}</a>
        </li>
        <li>
          <a class="hover:text-ink" href="#workflow">{footer.navLinks.workflow}</a>
        </li>
        <li>
          <a class="hover:text-ink" href="#examples">{footer.navLinks.examples}</a>
        </li>
        <li>
          <a class="hover:text-ink" href="#locales">{footer.navLinks.locales}</a>
        </li>
        <li>
          <a
            class="hover:text-ink"
            href={repoHref}
            target="_blank"
            rel="noopener"
          >
            {footer.navLinks.source}
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>