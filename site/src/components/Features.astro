---
import type { FeaturesCopy, Locale } from "../i18n/types";

interface Props {
  features: FeaturesCopy;
  locale: Locale;
}

const { features, locale } = Astro.props;

// JSON code snippet adapts to the current locale: top-level locale field
// matches the page language so the snippet is internally consistent.
const jsonSnippet =
  locale === "zh"
    ? `{
  "locale": "zh-CN",
  "name": { "full": "...", "pinyin": "..." },
  "contact": { "email": "...", "phone": "..." },
  "sections": [
    { "title": "教育经历", "entries": [...] },
    { "title": "工作经历", "entries": [...] }
  ]
}`
    : `{
  "locale": "en-US",
  "name": { "full": "...", "...": "..." },
  "contact": { "email": "...", "links": [...] },
  "sections": [
    { "title": "Education", "entries": [...] },
    { "title": "Experience", "entries": [...] }
  ]
}`;

const skillSnippet = `---
name: json-resume
description: |
  Author a resume JSON, render a
  DOCX or PDF in one command.
inputs:
  - name: input_json
    type: file
  - name: output_docx
    type: file
---`;

const terminalCmd =
  locale === "zh"
    ? `$ ./.venv/bin/python main.py input/resume.json \\
      -o output/resume.docx --pdf

已写入 output/resume.docx
已写入 output/resume.pdf
完成。`
    : `$ ./.venv/bin/python main.py input/resume.json \\
      -o output/resume.docx --pdf

Wrote output/resume.docx
Wrote output/resume.pdf
Done.`;
---

<section id="features" class="border-t border-rule">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
    <div class="max-w-[58ch] jr-rise">
      <p
        class="font-mono-tight text-[11.5px] uppercase tracking-[0.18em] text-ink-faint"
      >
        {features.eyebrow}
      </p>
      <h2
        class="mt-4 font-display text-[clamp(1.75rem,3.2vw,2.5rem)] font-semibold tracking-tight text-ink"
      >
        {features.heading}
      </h2>
      <p class="mt-4 text-[16px] leading-[1.6] text-ink-muted">
        {features.body}
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-y-20 lg:gap-y-28">
      {/* Item 1: text left, snippet right */}
      <div
        class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-12 jr-rise"
      >
        <div class="lg:col-span-5">
          <span
            aria-hidden="true"
            class="inline-block h-[2px] w-8"
            style="background-color: var(--color-accent);"
          ></span>
          <h3
            class="mt-3 font-display text-[clamp(1.4rem,2.4vw,1.85rem)] font-semibold tracking-tight text-ink"
          >
            {features.items[0].title}
          </h3>
          <p class="mt-4 max-w-[48ch] text-[15.5px] leading-[1.6] text-ink-muted">
            {features.items[0].body}
          </p>
        </div>
        <div class="lg:col-span-7">
          <div
            class="overflow-hidden rounded-[var(--radius-card)] border border-rule bg-surface-raised shadow-card transition-colors duration-300 hover:border-rule-strong"
          >
            <div
              class="flex items-center justify-between border-b border-rule px-4 py-2"
            >
              <span class="font-mono-tight text-[11px] text-ink-faint">
                {features.jsonLabel}
              </span>
              <span class="font-mono-tight text-[10.5px] text-ink-faint">
                {features.jsonLines}
              </span>
            </div>
            <pre
              class="overflow-x-auto px-4 py-4 font-mono-tight text-[12.5px] leading-[1.65] text-ink"
            ><code>{jsonSnippet}</code></pre>
          </div>
        </div>
      </div>

      {/* Item 2: text right, visual left (zig) */}
      <div
        class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-12 jr-rise"
      >
        <div class="order-2 lg:order-1 lg:col-span-7">
          <div
            class="overflow-hidden rounded-[var(--radius-card)] border border-rule bg-surface-raised shadow-card transition-colors duration-300 hover:border-rule-strong"
          >
            <div
              class="flex items-center justify-between border-b border-rule px-4 py-2"
            >
              <span class="font-mono-tight text-[11px] text-ink-faint">
                {features.terminalLabel}
              </span>
              <span class="font-mono-tight text-[10.5px] text-ink-faint">
                {features.terminalCmd}
              </span>
            </div>
            <pre
              class="overflow-x-auto px-4 py-4 font-mono-tight text-[12.5px] leading-[1.7] text-ink"
            ><code>{terminalCmd}</code></pre>
          </div>
        </div>
        <div class="order-1 lg:col-span-5 lg:order-2">
          <span
            aria-hidden="true"
            class="inline-block h-[2px] w-8"
            style="background-color: var(--color-accent);"
          ></span>
          <h3
            class="mt-3 font-display text-[clamp(1.4rem,2.4vw,1.85rem)] font-semibold tracking-tight text-ink"
          >
            {features.items[1].title}
          </h3>
          <p class="mt-4 max-w-[48ch] text-[15.5px] leading-[1.6] text-ink-muted">
            {features.items[1].body}
          </p>
        </div>
      </div>

      {/* Item 3: text left, snippet right */}
      <div
        class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-12 jr-rise"
      >
        <div class="lg:col-span-5">
          <span
            aria-hidden="true"
            class="inline-block h-[2px] w-8"
            style="background-color: var(--color-accent);"
          ></span>
          <h3
            class="mt-3 font-display text-[clamp(1.4rem,2.4vw,1.85rem)] font-semibold tracking-tight text-ink"
          >
            {features.items[2].title}
          </h3>
          <p class="mt-4 max-w-[48ch] text-[15.5px] leading-[1.6] text-ink-muted">
            {features.items[2].body}
          </p>
        </div>
        <div class="lg:col-span-7">
          <div
            class="overflow-hidden rounded-[var(--radius-card)] border border-rule bg-surface-raised shadow-card transition-colors duration-300 hover:border-rule-strong"
          >
            <div
              class="flex items-center justify-between border-b border-rule px-4 py-2"
            >
              <span class="font-mono-tight text-[11px] text-ink-faint">
                {features.skillLabel}
              </span>
              <span class="font-mono-tight text-[10.5px] text-ink-faint">
                {features.skillContext}
              </span>
            </div>
            <pre
              class="overflow-x-auto px-4 py-4 font-mono-tight text-[12.5px] leading-[1.65] text-ink"
            ><code>{skillSnippet}</code></pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>