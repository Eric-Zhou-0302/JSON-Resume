---
import type { LocalesCopy } from "../i18n/types";

interface Props {
  locales: LocalesCopy;
}

const { locales } = Astro.props;
---

<section id="locales" class="border-t border-rule bg-surface">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
    <div class="max-w-[58ch] jr-rise">
      <h2
        class="font-display text-[clamp(1.75rem,3.2vw,2.5rem)] font-semibold tracking-tight text-ink"
      >
        {locales.heading}
      </h2>
      <p class="mt-4 text-[16px] leading-[1.6] text-ink-muted">
        {locales.body}
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2">
      {
        locales.list.map((l) => (
          <article class="flex items-start gap-5 rounded-[var(--radius-card)] border border-rule bg-surface-raised p-6 shadow-card">
            <div
              aria-hidden="true"
              class="grid h-16 w-16 shrink-0 place-items-center rounded-[12px] border border-rule font-display text-[28px] font-semibold"
              style="background-color: var(--canvas); color: var(--ink);"
            >
              {l.glyph}
            </div>
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <span class="font-mono-tight text-[12.5px] font-medium text-ink">
                  {l.code}
                </span>
                <span
                  aria-hidden="true"
                  class="h-3 w-px bg-rule-strong"
                />
                <span class="font-mono-tight text-[12px] text-ink-faint">
                  {l.page}
                </span>
              </div>
              <h3 class="mt-2 font-display text-[18px] font-semibold tracking-tight text-ink">
                {l.name}
              </h3>
              <p class="mt-1 text-[13.5px] leading-[1.55] text-ink-muted">
                {l.note}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>