---
import Sun from "phosphor-astro/Sun.astro";
import Moon from "phosphor-astro/Moon.astro";
import GithubMark from "./GithubMark.astro";
import type { NavCopy } from "../i18n/types";
import { otherLocaleHref } from "../i18n";

interface Props {
  nav: NavCopy;
  locale: "zh" | "en";
}

const { nav, locale } = Astro.props;
const repoHref = "https://github.com/Eric-Zhou-0302/JSON-Resume";
const switchHref = otherLocaleHref(locale);
const homeHref = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<header class="sticky top-0 z-40 border-b border-rule bg-canvas/85 backdrop-blur">
  <div
    class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-4 sm:px-6 lg:px-8"
  >
    <a
      href={homeHref}
      class="group flex items-center gap-2.5 text-ink"
      aria-label="JSON-Resume home"
    >
      <span
        aria-hidden="true"
        class="grid h-7 w-7 place-items-center rounded-[8px] bg-[#0F1A14] text-[#34D399] font-mono-tight text-[12px] font-semibold"
      >
        {"{}"}
      </span>
      <span class="font-display text-[15px] font-semibold tracking-tight">
        JSON-Resume
      </span>
    </a>

    <nav
      class="hidden items-center gap-7 text-[13.5px] text-ink-muted md:flex"
      aria-label="Primary"
    >
      <a href="#features" class="hover:text-ink">{nav.features}</a>
      <a href="#workflow" class="hover:text-ink">{nav.workflow}</a>
      <a href="#examples" class="hover:text-ink">{nav.examples}</a>
      <a href="#locales" class="hover:text-ink">{nav.locales}</a>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={switchHref}
        class="inline-flex h-9 items-center gap-1.5 rounded-[var(--radius-control)] border border-rule px-2.5 text-[12.5px] font-medium text-ink-muted hover:bg-surface hover:text-ink"
        aria-label={`Switch language to ${nav.switchTo.label}`}
        lang={nav.switchTo.code}
      >
        <span class="font-mono-tight text-[11px] uppercase tracking-[0.12em]">
          {nav.switchTo.code}
        </span>
        <span>{nav.switchTo.label}</span>
      </a>

      <button
        type="button"
        data-theme-toggle
        class="grid h-9 w-9 place-items-center rounded-[var(--radius-control)] border border-rule text-ink-muted hover:bg-surface hover:text-ink"
        aria-label="Toggle theme"
      >
        <Sun class="block h-4 w-4 dark:hidden" />
        <Moon class="hidden h-4 w-4 dark:block" />
      </button>

      <a
        href={repoHref}
        target="_blank"
        rel="noopener"
        class="flex h-9 w-9 items-center justify-center rounded-[var(--radius-control)] border border-rule-strong sm:hidden"
        style="background-color: var(--ink); color: var(--canvas);"
        aria-label="View repository on GitHub"
      >
        <GithubMark class="h-4 w-4" />
      </a>

      <a
        href={repoHref}
        target="_blank"
        rel="noopener"
        class="hidden items-center gap-1.5 rounded-[var(--radius-control)] border border-rule-strong px-3.5 py-2 text-[13px] font-medium hover:opacity-90 sm:flex"
        style="background-color: var(--ink); color: var(--canvas);"
      >
        <GithubMark class="h-3.5 w-3.5" />
        <span>GitHub</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.querySelector("[data-theme-toggle]");
    if (!btn) return;
    btn.addEventListener("click", function () {
      var root = document.documentElement;
      var current =
        root.getAttribute("data-theme") ||
        (window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light");
      var next = current === "dark" ? "light" : "dark";
      root.setAttribute("data-theme", next);
      try {
        localStorage.setItem("jr-theme", next);
      } catch (e) {
        /* ignore */
      }
    });
  })();
</script>
